    global_lets: [],
    text: "---\npolicy-version: 2\n---\n\n```policy\nfact Players[gameID: id]=>{x: id, o: id}\nfact NextPlayer[gameID: id]=>{p: string}\nfact Field[gameID: id, x: int, y: int]=>{p: string}\nfact GameOver[gameID: id]=>{}\n\n// Regular functions can only contain data processing statements, must\n// have a return type, and must return a value\nfunction bounds(v: int) bool {\n    return v >= 0 && v <= 2;\n}\n// finish functions can only be used in finish blocks and can only contain\n// statements valid in finish blocks\nfinish function set_next_player(gameID: id, to_input: string) {\n    update NextPlayer[gameID] to {p: to_input}\n}\n\naction[null] StartGame(profileX: id, profileO: id) {\n    let start_command = Start{\n        ProfileX: profileX,\n        ProfileO: profileO,\n    };\n    publish start_command;\n}\n\neffect GameStart {\n    gameID: id,\n    x: id,\n    o: id,\n}\n\ncommand Start with Base {\n    fields {\n        ProfileX: id,\n        ProfileO: id,\n    }\n    policy(this, envelope) {\n        check ProfileX != ProfileO else test_fail(\"Profiles must be different\");\n        let gameID = envelope.command_id;\n        finish {\n            create PlayerProfile[gameID]=>{x: ProfileX, o: ProfileO}\n            create NextPlayer[gameID]=>{p: \"X\"}\n\n            emit GameStart{\n                gameID,\n                x: ProfileX,\n                o: ProfileO,\n            };\n        }\n    }\n}\n\naction[null] MakeMove(gameID: id, x: int, y: int) {\n    let move_command = Move {\n        gameID,\n        X: x,\n        Y: y,\n    };\n    publish move_command;\n}\n\neffect GameUpdate {\n    gameID: id,\n    player: id,\n    p:      string,\n    X:      int,\n    Y:      int,\n}\n\neffect GameOver {\n    gameID: id,\n    winner: id,\n    p: string,\n}\n\ncommand Move with Base {\n    // phase 0: command field definition\n    fields {\n        gameID: id,\n        X: int,\n        Y: int,\n    }\n    policy(this) {\n        // phase 1: variable definition/checks\n        // These aren't \"variables\" in the procedural sense, they are\n        // set-once constant definitions that can be used in later\n        // expressions.\n        let player = envelope.author_id;\n        // the query expression searches the fact database for facts which\n        // match the signature, returning an Optional containing either all\n        // values marked with ?, or None. The `or` operator unwraps the result\n        // of the query, if it is `Some`, or invokes the test_fail() expression,\n        // which terminates the policy with an error.\n        let res = query PlayerProfile[gameID]=>{x: ?, o: ?} or test_fail();\n        let playerX = res.x;\n        let playerO = res.o;\n        let p = query NextPlayer[gameID]=>{p: ?} or test_fail();\n        // the if expression works like a ternary expression, where both\n        // branches must be specified.\n        let nextp = if p == \"X\" { \"O\" } else { \"X\" };\n\n        // Checks are separated here, but they can be interleaved with let\n        // statements.\n        // Defined variables, command fields, and common event fields can\n        // be checked for validity with boolean expressions.\n        check (p == \"X\" && player == playerX) || (p == \"O\" && player == playerO) else test_fail(\"bad state: wrong player\");\n        // functions can be used in any expression\n        check bounds(X) else test_fail(\"X out of bounds\");\n        check bounds(Y) else test_fail(\"Y out of bounds\");\n\n        // phase 2: fact updates and effects\n        // Facts can be created, updated, and destroyed.\n        // Zero or more effects can be generated.\n        // The finish block ends rule evaluation.\n        finish {\n            create Field[gameID, x: X, y: Y]=>{p}\n            set_next_player(gameID, nextp);\n\n            emit GameUpdate{\n                gameID,\n                player,\n                p,\n                X,\n                Y,\n            };\n        }\n    }\n}\n\nfunction game_over(gameID: id, x: int, y: int, p: string) bool {\n    let f00 = if x == 0 && y == 0 { Some(p) } else { query Field[gameID, x: 0, y: 0]=>{p: ?} };\n    let f10 = if x == 1 && y == 0 { Some(p) } else { query Field[gameID, x: 1, y: 0]=>{p: ?} };\n    let f20 = if x == 2 && y == 0 { Some(p) } else { query Field[gameID, x: 2, y: 0]=>{p: ?} };\n    let f01 = if x == 0 && y == 1 { Some(p) } else { query Field[gameID, x: 0, y: 1]=>{p: ?} };\n    let f11 = if x == 1 && y == 1 { Some(p) } else { query Field[gameID, x: 1, y: 1]=>{p: ?} };\n    let f21 = if x == 2 && y == 1 { Some(p) } else { query Field[gameID, x: 2, y: 1]=>{p: ?} };\n    let f02 = if x == 0 && y == 2 { Some(p) } else { query Field[gameID, x: 0, y: 2]=>{p: ?} };\n    let f12 = if x == 1 && y == 2 { Some(p) } else { query Field[gameID, x: 1, y: 2]=>{p: ?} };\n    let f22 = if x == 2 && y == 2 { Some(p) } else { query Field[gameID, x: 2, y: 2]=>{p: ?} };\n    return (f00 is Some && f00 == f10 && f10 == f20) ||\n           (f01 is Some && f01 == f11 && f11 == f21) ||\n           (f01 is Some && f02 == f12 && f12 == f22) ||\n           (f00 is Some && f00 == f01 && f01 == f02) ||\n           (f10 is Some && f10 == f11 && f11 == f12) ||\n           (f20 is Some && f20 == f21 && f21 == f22) ||\n           (f00 is Some && f00 == f11 && f11 == f22) ||\n           (f20 is Some && f20 == f11 && f11 == f02);\n}\n\ncommand Move2 with Base {\n    fields {\n        gameID: id,\n        X: int,\n        Y: int,\n    }\n    policy(this) {\n        let player = envelope.author_id;\n        let players = query PlayerProfile[gameID]=>{x: ?, o: ?} or test_fail();\n        let p = query NextPlayer[gameID]=>{p: ?} or test_fail();\n        let nextp = if p == \"X\" { \"O\" } else { \"X\" };\n\n        check !exists GameOver[gameID]=>{} else test_fail(\"game is over\");\n        check bounds(X) else test_fail(\"X invalid\");\n        check bounds(Y) else test_fail(\"Y invalid\");\n        check (p == \"X\" && player == players.x) || (p == \"O\" && player == players.o) else test_fail(\"bad state: wrong player\");\n\n        match game_over(gameID, X, Y, p) {\n            true => {\n                finish {\n                    create Field[gameID, x: X, y: Y]=>{p}\n                    delete NextPlayer[gameID]=>{p}\n                    create GameOver[gameID]=>{}\n                    emit GameOver{\n                        gameID,\n                        winner: player,\n                        p,\n                    };\n                }\n            }\n            false => {\n                finish {\n                    create Field[gameID, x: X, y: Y]=>{p}\n                    set_next_player(gameID, op);\n                    emit GameUpdate{\n                        gameID,\n                        player,\n                        p,\n                        x: X,\n                        y: Y,\n                    };\n                }\n            }\n        }\n    }\n}\n```\n",
}
