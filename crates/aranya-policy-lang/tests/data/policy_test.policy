// This is not a valid policy. It is just meant to exercise
// every feature of the parser.
/* block comment */
fact F[v: string]=>{x: int, y: bool}

action[null] add2(x: int, y: int) {
    let obj = Add {
        count: x,
    }
    publish obj
}

effect Added {
    x: int,
    y: int,
}

command Add with Base {
    fields {
        count: int
    }
    policy(this, envelope) {
        let envelope_id = envelope.command_id
        let author = envelope.author_id
        let new_x = add2(x, count)
        check exists TestFact[v: "test"]=>{} else recall default(this, envelope)
        match x {
            0 => {
                check positive(Some(new_x)) else recall default(this, envelope)
            }
            1 => {
                check positive(None) else recall default(this, envelope)
            }
            _ => {

            }
        }

        if x == 3 {
            check new_x < 10 else recall default(this, envelope)
        }

        let a = foo::ext_func(x)

        finish {
            create F[v: "hello"]=>{x, y: saturating_sub(0, x)}
            update F[]=>{x} to {x: new_x}
            delete F[v: "hello"]
            emit Added {
                x: new_x,
                y: count,
            }
        }
    }
    recall default(this, envelope) {
        let envelope_id = envelope.command_id
        let author = envelope.author_id
        let new_x = add2(x, count)
        finish {
            create F[v: "hello"]=>{x, y: saturating_sub(0, x)}
            update F[]=>{x} to {x: new_x}
            delete F[v: "hello"]
            emit Added {
                x: new_x,
                y: count,
            }
        }
    }
}

function positive(v: option[int]) bool {
    return match v {
        Some(x) => x > 0
        None => test_fail()
    }
}

finish function next(x: int) {
    create Next[]=>{}
}


// ephemeral commands and actions

base[ephemeral] Ephemeral {
    get_key(_dev: id) option[bytes] { return None }
}

command C with Ephemeral {
    fields {
        x: int
    }
    policy(this) {}
}

action[ephemeral] a() {}
