enum Result { OK, Error }
action[null] test() {
    publish Pub {}
    let ok = Result::OK
    check ok == Result::OK else test_fail()
    check ok != Result::Error else test_fail()

    match ok {
        Result::OK => {}
        Result::Error => {}
    }
}

command Pub with StubBase {
    fields {}
    policy {
        finish {}
    }
}
