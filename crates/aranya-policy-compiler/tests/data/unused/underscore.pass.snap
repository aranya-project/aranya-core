Module {
    version: "1",
    labels: {
        <fn 'f'>: 1,
    },
    action_defs: [],
    command_defs: [],
    fact_defs: [],
    struct_defs: [],
    enum_defs: [],
    globals: {},
    ..
}
---
    exit panic
<fn 'f'>:
    def '_arg'
    save SP
    const true
    def '_var'
    const ()
    restore SP
    return
    exit panic
