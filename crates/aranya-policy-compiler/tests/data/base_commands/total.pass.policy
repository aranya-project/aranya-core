fact Key[dev: id]=>{key: bytes}

base[init] MyInitBase {
    fields {
        key: bytes
    }
    get_key(this, _dev: id) option[bytes] {
        return Some(this.key)
    }
}

base[basic] MyBasicBase {
    get_key(dev: id) option[bytes] {
        return match query Key[dev] {
            Some(f) => Some(f.key)
            None => None
        }
    }
}

command MyInit with MyInitBase {
    policy(this) {}
}

command MyBasic1 with MyBasicBase {
    policy(this) {}
}

command MyBasic2 with MyBasicBase {
    policy(this) {}
}

action[init] my_init(key: bytes) {
    publish MyInit { key: key }
}

action[basic] my_basic_1() {
    publish MyBasic1 { }
}

action[basic] my_basic_2() {
    publish MyBasic2 { }
}
