command Result with StubBase {
    fields {
        x: int
    }
    policy(this) { }
}

action[null] foo(x: int) {
    match x {
        5 => {
            publish Result { x }
        }
        _ => {
            publish Result { x: 0 }
        }
        6 => {
            publish Result { x }
        }
    }
}
