Module {
    version: "1",
    labels: {
        <fn 'double'>: 1,
        <fn 'make_pair'>: 20,
        <fn 'sum'>: 10,
    },
    action_defs: [],
    command_defs: [],
    fact_defs: [],
    struct_defs: [
        StructDef {
            name: "Pair",
            items: [
                Field {
                    name: "a",
                    vtype: Int,
                },
                Field {
                    name: "b",
                    vtype: Int,
                },
            ],
        },
    ],
    enum_defs: [],
    globals: {},
    ..
}
---
    exit panic
<fn 'double'>:
    def 'x'
    save SP
    get 'x'
    get 'x'
    call <fn 'make_pair'>
    call <fn 'sum'>
    restore SP
    return
    exit panic
<fn 'sum'>:
    def 'p'
    save SP
    get 'p'
    struct.get 'a'
    get 'p'
    struct.get 'b'
    saturating_add
    restore SP
    return
    exit panic
<fn 'make_pair'>:
    def 'b'
    def 'a'
    save SP
    struct.new 'Pair'
    get 'a'
    struct.set 'a'
    get 'b'
    struct.set 'b'
    restore SP
    return
    exit panic
